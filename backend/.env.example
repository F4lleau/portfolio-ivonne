DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret-before-deploying
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Empty uses SQLite for local development. Never expose this URL to Vite.
DATABASE_URL=
# Neon runtime URL: restricted role without BYPASSRLS, sslmode=require.
# DATABASE_URL=postgresql://portfolio_app:password@host/db?sslmode=require
ADMIN_EMAIL=ivonnefalleau@gmail.com
# Optional S3-compatible object storage; otherwise persistent local media.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional SMTP; messages are saved even when delivery fails.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=portfolio@example.com
CONTACT_NOTIFY_EMAIL=ivonnefalleau@gmail.com
# Optional server-side token for higher GitHub API rate limits.
GITHUB_TOKEN=

# Enable only behind a trusted TLS proxy that overwrites forwarded headers.
TRUST_PROXY_HEADERS=false
